---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GenerativeAiLanding from '../../components/GenerativeAiLanding.astro';
import { generativeAiDevelopmentCopy } from '../../data/copy/generative-ai-development';
---

<BaseLayout
  title={generativeAiDevelopmentCopy.title}
  description={generativeAiDevelopmentCopy.description}
  canonicalPath="/services/generative-ai-development.html"
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  modulePreloads={[]}
  stylesheets={['https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Unbounded:wght@600;700;800&display=swap']}
  skipAppCss={false}
  entryScript={null}
  schemaKind="service"
  faqs={generativeAiDevelopmentCopy.faqs}
>
  <GenerativeAiLanding />
</BaseLayout>
