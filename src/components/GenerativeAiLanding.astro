<script is:inline>
  const mobile = document.getElementById('dw-mobile');
  const menuBtn = document.getElementById('dw-menu-btn');
  menuBtn?.addEventListener('click', () => {
    const open = mobile.hasAttribute('hidden');
    if (open) mobile.removeAttribute('hidden');
    else mobile.setAttribute('hidden', '');
    menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  const bar = document.getElementById('dw-bar');
  const syncBar = () => bar?.classList.toggle('is-stuck', (window.scrollY || 0) > 24);
  syncBar();
  window.addEventListener('scroll', syncBar, { passive: true });
  const industries = document.getElementById('dw-ind');
  industries?.querySelectorAll('.dw-ind-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      industries.querySelectorAll('.dw-ind-tab').forEach((item) => {
        const on = item === tab;
        item.classList.toggle('is-on', on);
        item.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      industries.querySelectorAll('.dw-ind-panel').forEach((panel) => {
        panel.classList.toggle('is-on', panel.dataset.ind === tab.dataset.ind);
      });
    });
  });
  document.querySelectorAll('[data-group]').forEach((button) => {
    const show = () => {
      const root = button.closest('[data-svc]');
      root.querySelectorAll('[data-group]').forEach((item) => item.classList.toggle('is-on', item === button));
      root.querySelectorAll('[data-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.panel !== button.dataset.group;
      });
    };
    button.addEventListener('mouseenter', show);
    button.addEventListener('focus', show);
  });
</script>

