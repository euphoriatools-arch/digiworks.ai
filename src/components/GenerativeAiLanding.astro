      ['Generative AI', '/solutions/generative-ai'],
      ['AI in Cybersecurity', '/solutions/ai-for-cybersecurity'],
      ['Image Intelligence', '/solutions/computer-vision-image-recognition'],
    ],
  },
  {
    label: 'Industries',
    items: [
      ['Healthcare', '/industries/ai-for-healthcare'],
      ['Fintech', '/industries/ai-for-fintech'],
      ['Retail & E-commerce', '/industries/ai-for-retail-and-ecommerce'],
      ['Manufacturing', '/industries/ai-for-manufacturing'],
      ['Logistics & Supply Chain', '/industries/ai-for-logistics-and-supply-chain'],
