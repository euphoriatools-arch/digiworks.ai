---

<div class="gai relative min-h-screen overflow-x-clip">
  <header class="fixed inset-x-0 top-0 z-50">
      <div id="dw-bar" class="mx-auto mt-3 flex max-w-7xl items-center justify-between gap-3 rounded-2xl border border-transparent bg-transparent px-4 py-2.5 transition-all duration-500 sm:mx-5 xl:mx-auto">
      <a class="group flex shrink-0 items-center transition-transform duration-300 hover:scale-[1.03]" href="/" aria-label="DigiWorks AI, home">
        <img src="/logo-white.png" alt="DigiWorks AI" class="h-9 w-auto" width="280" height="46" />
      </a>
      <nav class="hidden items-center lg:flex" aria-label="Primary">
        <div class="dw-svc relative" data-svc>
          <button type="button" class="flex items-center gap-1 whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-dusk/70 transition-colors hover:text-dusk xl:px-3.5" aria-haspopup="true">
            Services
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
          </button>
          <div class="dw-mega">
            <div class="grid overflow-hidden rounded-3xl border border-white/10 bg-[#09070b]/95 shadow-[0_24px_64px_rgba(0,0,0,0.65)]" style="grid-template-columns:16.5rem minmax(0,1fr);min-height:22rem">
              <div class="flex flex-col gap-1 border-r border-white/10 bg-white/[0.03] px-3 pb-3 pt-6">
                {serviceGroups.map((group, index) => (
                  <button type="button" data-group={index} class:list={['flex items-center justify-between rounded-xl px-3 py-3 text-left text-sm font-semibold', index === 0 ? 'is-on' : 'text-dusk/75']}>
                    {group.label}
                  </button>
                ))}
              </div>
              <div class="px-5 pb-5 pt-6">
                {serviceGroups.map((group, index) => (
                  <div data-panel={index} hidden={index !== 0}>
                    <p class="mb-3 text-lg font-bold text-dusk">{group.label}</p>
                    <div class="grid gap-1 sm:grid-cols-2">
                      {group.items.map(([label, href], itemIndex) => (
                        <a href={href} class:list={['block rounded-lg px-3 py-2.5 text-sm', itemIndex === 0 ? 'font-semibold text-cyan' : 'text-dusk/75']}>{label}</a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        {menus.map((menu) => (
          <div class="dw-item relative">
            <button type="button" class="flex items-center gap-1 whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-dusk/70 transition-colors hover:text-dusk xl:px-3.5" aria-haspopup="true">
              {menu.label}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
            </button>
            <div class="dw-drop absolute left-0 top-full z-50 mt-3 w-72 rounded-2xl border border-white/10 bg-[#09070b]/95 p-2 shadow-[0_24px_64px_rgba(0,0,0,0.65)]">
              {menu.items.map(([label, href]) => (
                <a class="block rounded-lg px-3 py-2.5 text-sm text-dusk/75" href={href}>{label}</a>
              ))}
            </div>
          </div>
        ))}
        <a class="ml-1 flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-2 text-sm font-semibold text-dusk/80 transition-colors hover:text-dusk xl:px-3.5" href="/case-studies"><span class="bg-gradient-to-r from-coral to-violet bg-clip-text text-transparent">Case Studies</span></a>
      </nav>
      <div class="ml-3 hidden shrink-0 items-center gap-4 lg:flex xl:ml-5">
        <a href="tel:+17373945488" class="ember-trace flex items-center justify-center gap-2 rounded-full border border-[#4c9eff]/20 bg-[#0c1424]/70 px-5 py-2 text-center text-sm font-semibold text-white transition-all duration-300 hover:bg-[#0c1424]/90 hover:shadow-[0_0_14px_rgba(76,158,255,0.22)]" aria-label="Call us at +1 737 394 5488">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 stroke-current" fill="none" stroke-width="2" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"></path></svg>
          <span class="hidden xl:inline">+1 737 394 5488</span>
        </a>
        <a class="btn-primary whitespace-nowrap !px-5" href="/contact">Book a Call</a>
      </div>
      <button id="dw-menu-btn" type="button" aria-label="Menu" aria-expanded="false" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-dusk/15 bg-panel/80 lg:hidden">
        <span class="space-y-1.5">
          <span class="block h-0.5 w-5 bg-white"></span>
          <span class="block h-0.5 w-5 bg-white"></span>
          <span class="block h-0.5 w-5 bg-white"></span>
        </span>
      </button>
    </div>
    <div id="dw-mobile" hidden class="mx-5 mt-2 rounded-2xl border border-white/10 bg-[#0c1424] p-4 lg:hidden">
      {menus.map((menu) => (
        <div class="mb-3">
          <p class="px-2 text-xs font-bold uppercase tracking-[0.18em] text-cyan">{menu.label}</p>
          {menu.items.map(([label, href]) => <a class="block rounded-lg px-2 py-2 text-sm text-dusk/80" href={href}>{label}</a>)}
        </div>
      ))}
      <a class="btn-primary mt-2 w-full" href="/contact">Book a Call</a>
