<script is:inline>
  const mobile = document.getElementById('dw-mobile');
  document.getElementById('dw-menu-btn')?.addEventListener('click', () => {
    if (mobile.hasAttribute('hidden')) mobile.removeAttribute('hidden');
    else mobile.setAttribute('hidden', '');
  });
  document.querySelectorAll('[data-group]').forEach((button) => {
    const show = () => {
      const root = button.closest('[data-svc]');
      root.querySelectorAll('[data-group]').forEach((item) => item.classList.toggle('is-on', item === button));
      root.querySelectorAll('[data-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.panel !== button.dataset.group;
      });
    };
    button.addEventListener('mouseenter', show);
    button.addEventListener('focus', show);
  });
</script>

