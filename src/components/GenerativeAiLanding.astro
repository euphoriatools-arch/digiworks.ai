const industries = [
  ['Technology & SaaS', 'AI features, support assistants and product knowledge.'],
  ['Healthcare', 'Administrative document workflows and internal knowledge, subject to privacy requirements.'],
  ['Financial services', 'Research assistance, document review and internal policy search with appropriate controls.'],
  ['Retail & e-commerce', 'Catalog assistance, product discovery and customer support.'],
  ['Manufacturing', 'Technical manuals, troubleshooting guidance and operational knowledge.'],
  ['Professional services', 'Research, proposal drafting and document review with expert oversight.'],
];

const steps = [
  ['01', 'Discovery & feasibility', 'Identify the workflow, users, constraints and baseline metrics. Agree on acceptance criteria and assess whether generative AI is appropriate.', 'Output: use-case brief and scope'],
  ['02', 'Data & architecture', 'Review data access, quality and retention. Compare models, retrieval and integration options, then define security and deployment boundaries.', 'Output: architecture and evaluation plan'],
  ['03', 'Prototype & evaluation', 'Build a narrow proof of concept using representative inputs. Test quality, safety, cost and latency before expanding scope.', 'Output: pilot and evaluation results'],
  ['04', 'Engineering & integration', 'Implement application logic, APIs, access controls, test suites and operational safeguards. Validate with actual users and staged rollout criteria.', 'Output: tested application'],
  ['05', 'Deployment & improvement', 'Plan monitoring, incident handling, documentation and handoff. Review quality, usage and costs against agreed goals after deployment.', 'Output: deployment and support plan'],
];

const field = 'w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-dusk placeholder-dusk/40 outline-none transition-all duration-300 focus:border-coral/60 focus:bg-white/[0.07] focus:shadow-[0_0_0_3px_rgba(26,130,255,0.15)]';
---

<div class="gai relative min-h-screen overflow-x-clip">
  <header class="fixed inset-x-0 top-0 z-50">
      <div class="mx-auto mt-3 flex max-w-7xl items-center justify-between gap-3 rounded-2xl border border-white/10 bg-[#0c1424]/70 px-4 py-2.5 backdrop-blur-xl sm:mx-5 xl:mx-auto">
      <a class="shrink-0" href="/" aria-label="DigiWorks AI, home">
        <img src="/logo-white.png" alt="DigiWorks AI" class="h-9 w-auto" width="280" height="46" />
      </a>
      <nav class="hidden items-center lg:flex" aria-label="Primary">
        <div class="dw-svc relative" data-svc>
          <button type="button" class="flex items-center gap-1 whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-dusk/70" aria-haspopup="true">
            Services
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
          </button>
          <div class="dw-mega">
            <div class="grid overflow-hidden rounded-3xl border border-white/10 bg-[#09070b]/95 shadow-[0_24px_64px_rgba(0,0,0,0.65)]" style="grid-template-columns:16.5rem minmax(0,1fr);min-height:22rem">
              <div class="flex flex-col gap-1 border-r border-white/10 bg-white/[0.03] px-3 pb-3 pt-6">
                {serviceGroups.map((group, index) => (
                  <button type="button" data-group={index} class:list={['flex items-center justify-between rounded-xl px-3 py-3 text-left text-sm font-semibold', index === 0 ? 'is-on' : 'text-dusk/75']}>
                    {group.label}
                  </button>
                ))}
              </div>
              <div class="px-5 pb-5 pt-6">
                {serviceGroups.map((group, index) => (
                  <div data-panel={index} hidden={index !== 0}>
                    <p class="mb-3 text-lg font-bold text-dusk">{group.label}</p>
                    <div class="grid gap-1 sm:grid-cols-2">
                      {group.items.map(([label, href], itemIndex) => (
                        <a href={href} class:list={['block rounded-lg px-3 py-2.5 text-sm', itemIndex === 0 ? 'font-semibold text-cyan' : 'text-dusk/75']}>{label}</a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        {menus.map((menu) => (
          <div class="dw-item relative">
            <button type="button" class="flex items-center gap-1 whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-dusk/70" aria-haspopup="true">
              {menu.label}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
            </button>
            <div class="dw-drop absolute left-0 top-full z-50 mt-3 w-72 rounded-2xl border border-white/10 bg-[#09070b]/95 p-2 shadow-[0_24px_64px_rgba(0,0,0,0.65)]">
              {menu.items.map(([label, href]) => (
                <a class="block rounded-lg px-3 py-2.5 text-sm text-dusk/75" href={href}>{label}</a>
              ))}
            </div>
          </div>
        ))}
        <a class="ml-1 rounded-full px-3 py-2 text-sm font-semibold" href="/case-studies"><span class="text-gradient">Case Studies</span></a>
      </nav>
      <div class="ml-3 hidden shrink-0 items-center gap-4 lg:flex">
        <a href="tel:+17373945488" class="flex items-center gap-2 rounded-full border border-[#4c9eff]/20 bg-[#0c1424]/70 px-5 py-2 text-sm font-semibold text-white" aria-label="Call us at +1 737 394 5488">
          <span class="hidden xl:inline">+1 737 394 5488</span>
        </a>
        <a class="btn-primary whitespace-nowrap !px-5" href="#inquiry">Book a Call</a>
      </div>
      <button id="dw-menu-btn" type="button" aria-label="Menu" class="flex h-11 w-11 items-center justify-center rounded-xl border border-dusk/15 lg:hidden">
        <span class="block h-0.5 w-5 bg-white"></span>
      </button>
    </div>
    <div id="dw-mobile" hidden class="mx-5 mt-2 rounded-2xl border border-white/10 bg-[#0c1424] p-4 lg:hidden">
      {menus.map((menu) => (
        <div class="mb-3">
          <p class="px-2 text-xs font-bold uppercase tracking-[0.18em] text-cyan">{menu.label}</p>
          {menu.items.map(([label, href]) => <a class="block rounded-lg px-2 py-2 text-sm text-dusk/80" href={href}>{label}</a>)}
        </div>
      ))}
      <a class="btn-primary mt-2 w-full" href="#inquiry">Book a Call</a>
    </div>
  </header>

  <main id="main">
    <section class="relative overflow-hidden px-5 pb-24 pt-40 sm:px-8 md:pb-32 md:pt-48">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -left-32 top-10 h-96 w-96 rounded-full bg-electric/15 blur-[120px]"></div>
        <div class="absolute -right-24 top-1/3 h-80 w-80 rounded-full bg-cyan/10 blur-[110px]"></div>
        <div class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-violet/10 blur-[100px]"></div>
      </div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[300px]" aria-hidden="true">
        <div class="grid-floor absolute inset-x-[-30%] bottom-[-70%] h-[200%] rotate-180 opacity-70"></div>
      </div>
      <div class="dw-hero-grid relative z-10 mx-auto grid max-w-7xl items-center gap-10">
        <div>
          <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs text-dusk/55" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><span>Services</span><span>/</span><span>Generative AI</span>
          </nav>
          <span class="chip"><span class="h-1.5 w-1.5 rounded-full bg-coral"></span>Custom AI engineering for US businesses</span>
          <h1 class="mt-6 font-display text-3xl font-bold leading-[1.18] text-dusk sm:text-4xl md:text-5xl">
            <span class="text-dusk">Generative AI </span><span class="text-gradient">{copy.h1Gradient}</span>
          </h1>
          <p class="mt-7 max-w-2xl text-base leading-relaxed text-dusk/70 md:text-lg">{copy.hero} Work runs from initial strategy through integration and deployment.</p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a class="btn-primary" href="#inquiry">Discuss your AI project <span aria-hidden="true">→</span></a>
            <a class="btn-ghost" href="#services">Explore our services</a>
          </div>
        </div>
        <div class="glass relative hidden h-80 overflow-hidden rounded-3xl lg:block" aria-hidden="true">
          <div class="absolute left-1/2 top-1/2 h-20 w-20 -translate-x-1/2 -translate-y-1/2 rounded-2xl border border-cyan/40 bg-electric/20"></div>
          <span class="absolute left-[16%] top-[22%] rounded-xl border border-white/15 bg-white/[0.04] px-3 py-2 text-xs text-dusk/70">Mail</span>
          <span class="absolute right-[16%] top-[22%] rounded-xl border border-white/15 bg-white/[0.04] px-3 py-2 text-xs text-dusk/70">Docs</span>
          <span class="absolute left-[16%] bottom-[22%] rounded-xl border border-white/15 bg-white/[0.04] px-3 py-2 text-xs text-dusk/70">Data</span>
          <span class="absolute right-[16%] bottom-[22%] rounded-xl border border-white/15 bg-white/[0.04] px-3 py-2 text-xs text-dusk/70">Review</span>
        </div>
      </div>
    </section>

    <section class="section-pad dw-light relative">
      <div class="mx-auto max-w-7xl">
        <span class="chip">Engineered around your needs</span>
        <h2 class="mt-5 font-display text-2xl font-bold text-dusk sm:text-3xl md:text-4xl">From AI strategy to a working application</h2>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-dusk/70">Define the business outcome, connect the right data and evaluate performance before scaling.</p>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          <article class="glass rounded-3xl p-7"><h3 class="font-display text-lg font-bold text-dusk">Business-first discovery</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">Start with a measurable problem and a realistic scope.</p></article>
          <article class="glass rounded-3xl p-7"><h3 class="font-display text-lg font-bold text-dusk">Integrated engineering</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">Plan data, models, APIs and the user experience together.</p></article>
          <article class="glass rounded-3xl p-7"><h3 class="font-display text-lg font-bold text-dusk">Responsible deployment</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">Design review, monitoring and access controls from the outset.</p></article>
        </div>
      </div>
    </section>

    <section class="section-pad dw-light relative !pt-0">
      <div class="mx-auto max-w-3xl">
        <span class="chip">Understand the approach</span>
        <h2 class="mt-5 font-display text-2xl font-bold text-dusk sm:text-3xl md:text-4xl">What is generative AI development?</h2>
        <p class="mt-5 text-base leading-relaxed text-dusk/70">Generative AI development is the process of building software that uses AI models to create new content or responses from user input and relevant context. It combines model selection, data preparation, application engineering, testing and deployment. Most business applications use existing foundation models rather than training a new model from scratch.</p>
        <p class="mt-4 text-base leading-relaxed text-dusk/70">For a US business, a useful implementation starts with a specific operational or product need: an assistant that helps support teams resolve inquiries, a search experience for internal knowledge, or an application that processes documents for human review. The architecture should reflect accuracy requirements, data sensitivity, expected usage and budget.</p>
      </div>
    </section>

    <section class="section-pad dw-light relative" id="services">
      <div class="relative mx-auto max-w-7xl">
        <div class="mx-auto max-w-3xl text-center">
          <span class="chip">Our generative AI services</span>
          <h2 class="mt-5 font-display text-2xl font-bold text-dusk sm:text-3xl md:text-4xl">End-to-end generative AI development services</h2>
          <p class="mt-5 text-base leading-relaxed text-dusk/70">Choose a focused service or combine capabilities into a custom implementation. Each service addresses a distinct stage or application of AI engineering.</p>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-2">
          {services.map((item) => (
            <article class="glass rounded-3xl p-8">
              <h3 class="font-display text-xl font-bold text-dusk"><a href={item.href}>{item.title}</a></h3>
              <p class="mt-3 text-sm leading-relaxed text-dusk/70">{item.text}</p>
              <a class="mt-5 inline-flex text-sm font-semibold text-cyan" href={item.href}>Explore {item.title} →</a>
            </article>
          ))}
          <article class="dw-ink rounded-3xl p-8">
            <h3 class="font-display text-xl font-bold text-dusk">Not sure which service fits?</h3>
            <p class="mt-3 text-sm leading-relaxed text-dusk/70">Tell us what you want to achieve. We can discuss the right combination of consulting, AI development and integration.</p>
            <a class="btn-primary mt-6" href="#inquiry">Talk to our team</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section-pad aurora relative">
      <div class="relative mx-auto max-w-7xl">
        <span class="chip">Built for business workflows</span>
        <h2 class="mt-5 font-display text-2xl font-bold text-dusk sm:text-3xl md:text-4xl">Custom generative AI solutions for your business</h2>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-dusk/70">Match the solution to a real workflow and define how success will be evaluated before committing to a production build.</p>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          <article class="glass rounded-3xl p-7"><h3 class="font-display text-lg font-bold text-dusk">Customer experience</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">Assist support teams with draft responses, relevant knowledge and escalation. Track resolution time, answer accuracy and customer satisfaction.</p></article>
          <article class="glass rounded-3xl p-7"><h3 class="font-display text-lg font-bold text-dusk">Enterprise knowledge</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">Help employees locate relevant policies, manuals and product documentation. Evaluate citation accuracy, permission enforcement and time to answer.</p></article>
          <article class="glass rounded-3xl p-7"><h3 class="font-display text-lg font-bold text-dusk">Document workflows</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">Summarize, classify or extract information from contracts, invoices and reports. Use validation and reviewer feedback to measure usable output.</p></article>
          <article class="glass rounded-3xl p-7"><h3 class="font-display text-lg font-bold text-dusk">AI-enabled products</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">Introduce contextual search, writing assistance and other AI features into SaaS products. Measure adoption, task success, latency and cost per interaction.</p></article>
        </div>
      </div>
    </section>

    <section class="section-pad dw-light relative">
      <div class="mx-auto max-w-7xl">
        <span class="chip">Illustrative use case — not a client case study</span>
        <h2 class="mt-5 font-display text-2xl font-bold text-dusk sm:text-3xl md:text-4xl">How an enterprise knowledge assistant works</h2>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-dusk/70">Consider a support team that searches scattered product documentation. A RAG assistant can retrieve approved passages, provide a draft response with sources and escalate ambiguous questions for review.</p>
        <div class="dw-flow mt-12">
          <div class="glass rounded-3xl p-6"><strong class="font-display text-dusk">User request</strong><span class="mt-2 block text-sm text-dusk/55">Identity + policy</span></div>
          <div class="glass rounded-3xl p-6"><strong class="font-display text-dusk">Retrieve</strong><span class="mt-2 block text-sm text-dusk/55">Approved sources</span></div>
          <div class="glass rounded-3xl p-6"><strong class="font-display text-dusk">Generate</strong><span class="mt-2 block text-sm text-dusk/55">Model + context</span></div>
          <div class="glass rounded-3xl p-6"><strong class="font-display text-dusk">Review</strong><span class="mt-2 block text-sm text-dusk/55">Citations + controls</span></div>
        </div>
        <p class="mt-4 rounded-full border border-cyan/30 px-4 py-2 text-center text-sm font-semibold text-dusk">Evaluation and feedback loop</p>
        <p class="mt-4 text-sm leading-relaxed text-dusk/55">Example acceptance criteria: correct citation references, appropriate handling of unknown questions, no retrieval outside user permissions, acceptable response latency and a sustainable cost per request. These are proposed evaluation measures, not achieved client results.</p>
      </div>
    </section>

    <section class="section-pad dw-light relative">
      <div class="mx-auto max-w-7xl">
        <span class="chip">Industry applications</span>
        <h2 class="mt-5 font-display text-2xl font-bold text-dusk sm:text-3xl md:text-4xl">Generative AI for US industries</h2>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-dusk/70">Adapt applications to the workflows, data policies and operating requirements of your business. The following examples are potential applications, not claims of completed projects.</p>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {industries.map(([title, text]) => (
            <article class="glass rounded-3xl p-7"><h3 class="font-display text-lg font-bold text-dusk">{title}</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">{text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-pad aurora relative">
      <div class="relative mx-auto max-w-3xl">
        <span class="chip">Model-agnostic architecture</span>
        <h2 class="mt-5 font-display text-2xl font-bold text-dusk sm:text-3xl md:text-4xl">Generative AI technology stack</h2>
        <p class="mt-5 text-base leading-relaxed text-dusk/70">Choose tools according to task quality, privacy, latency, deployment constraints and total cost. Examples of technologies to evaluate include:</p>
        <div class="mt-8 space-y-4">
          <article class="glass rounded-3xl p-6"><h3 class="font-display text-lg font-bold text-dusk">Foundation models</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">OpenAI models, Claude, Gemini and open-weight models such as Llama. Compare output quality, usage terms and hosting options.</p></article>
          <article class="glass rounded-3xl p-6"><h3 class="font-display text-lg font-bold text-dusk">Data and retrieval</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">Embedding models, vector search such as pgvector or Pinecone, document processing and permission-aware indexing.</p></article>
          <article class="glass rounded-3xl p-6"><h3 class="font-display text-lg font-bold text-dusk">Application and orchestration</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">Python, TypeScript, APIs, structured outputs, workflow orchestration and integrations with existing systems.</p></article>
          <article class="glass rounded-3xl p-6"><h3 class="font-display text-lg font-bold text-dusk">Cloud and observability</h3><p class="mt-2 text-sm leading-relaxed text-dusk/70">AWS, Azure or Google Cloud where appropriate, plus evaluation tooling, logging and usage monitoring.</p></article>
        </div>
        <p class="mt-4 text-sm text-dusk/55">Technology examples do not imply vendor partnerships or certifications.</p>
      </div>
    </section>

    <section class="section-pad dw-light relative" id="process">
      <div class="mx-auto max-w-3xl">
        <span class="chip">Clear deliverables at every stage</span>
