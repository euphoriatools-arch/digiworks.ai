---
import { buildJsonLd, kindFromPath, type PageKind } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  kind?: PageKind;
  datePublished?: string;
  dateModified?: string;
  faqs?: { q: string; a: string }[];
  image?: string;
}

const {
  title,
  description,
  canonicalPath,
  kind = kindFromPath(canonicalPath),
  datePublished,
  dateModified,
  faqs,
  image,
} = Astro.props;

const json = buildJsonLd({
  kind,
  title,
  description,
  canonicalPath,
  datePublished,
  dateModified,
  faqs,
  image,
});
---

<script type="application/ld+json" set:html={json} />
